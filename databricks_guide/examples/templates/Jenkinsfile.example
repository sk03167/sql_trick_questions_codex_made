// OPT-IN: approved agent has pinned Python/Databricks CLI and source checkout.
pipeline {
  agent { label 'databricks-cli' }
  options { disableConcurrentBuilds() }
  environment {
    DATABRICKS_AUTH_TYPE = 'oauth-m2m'
    DATABRICKS_HOST = 'https://<dev-workspace-host>'
    DATABRICKS_CLIENT_ID = '<deployment-application-id>'
    BUNDLE_VAR_workspace_host = 'https://<dev-workspace-host>'
  }
  stages {
    stage('Local tests') {
      steps { sh 'python3 -m unittest discover -s databricks_guide/examples/tests -v' }
    }
    stage('Deploy and verify dev') {
      steps {
        withCredentials([string(credentialsId: 'databricks-dev-oauth-secret', variable: 'DATABRICKS_CLIENT_SECRET')]) {
          dir('databricks_guide/examples') {
            sh '''
              set +x
              databricks current-user me
              databricks bundle validate -t dev
              databricks bundle deploy -t dev
              databricks bundle run orders_daily -t dev --params 'catalog=de_lab_dev,run_date=2026-10-12,min_current_rows=2,validate_fixture=true'
            '''
          }
        }
      }
    }
  }
}
